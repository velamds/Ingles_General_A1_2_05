tent": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment. ", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn3le05ob07re2img05.jpg"}, {"text": "<span class=\"strong\">Travel Agent</span>: Okay, Ms. Wright. You are all booked for Mexico. </br>\n<span class=\"strong\">Vanessa</span>: Great, thank you!</br>\n<span class=\"strong\">Travel Agent</span>: May I offer you some tips about traveling to Mexico?</br>\n<span class=\"strong\">Vanessa</span>: Yes, of course. That would be very helpful. Thanks!</br>", "id": 1, "time": "10", "image": "engenn3le05ob07re2img05.jpg"}, {"text": "<span class=\"strong\">Travel Agent</span>: No problem. Shopping hours in big towns and cities start  around 10 or 11 a.m., and continue to between 8 and 10 p.m. </br>\n<span class=\"strong\">Vanessa</span>: Okay.</br>\n<span class=\"strong\">Travel Agent</span>: Banks are open from 9 a.m. to 4 p.m. in many cities, and some are even open Saturday mornings. HMBC opens from 8 a.m. to 8 p.m. six days a week.", "id": 2, "time": "13500", "image": "engenn3le05ob07re2img01.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>: Okay, should I always carry money with me? </br>\n<span class=\"strong\">Travel Agent</span>: Yes, but only carry small amounts. You should withdraw money from ATMs or go to currency exchange booths during the day. </br>\n<span class=\"strong\">Vanessa</span>: An exchange bureau? </br>\n<span class=\"strong\">Travel Agent</span>: It's a place where you can exchange money into the local currency.</br>\n<span class=\"strong\">Vanessa</span>: Okay, thanks for the tip. Thanks for all your help!</br>\n<span class=\"strong\">Travel Agent</span>: You're welcome. Enjoy Mexico!</br>", "id": 3, "time": "41000", "image": "engenn3le05ob07re2img05.jpg"}], "audiosrc": "engenn3le05ob07re2aud01", "coverimg": "engenn3le05ob07re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}