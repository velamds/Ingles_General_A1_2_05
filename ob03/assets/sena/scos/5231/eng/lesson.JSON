ype": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "At the Bank", "type": "lesson_name"}, {"content": "Thank You, but I'm Not Interested", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 5, "type": "lesson"}, {"content": "A1.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately explain information about interests, hobbies, and preferences in communicative situations.", "type": "primary"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_1"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_2"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_3"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_4"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_5"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_6"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_7"}, {"content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Making an Offer ", "type": "heading"}, {"content": "When you are at the bank, bank tellers can make polite offers for a service or offer other forms of help.  When making offers, it is common to use  <span class=\"strong\">modals</span> like  <span class=\"italic\">would</span> or  <span class=\"italic\">can</span>. These are common expressions you hear:<br><br> <span class=\"italic\">Can I help you?</br> Would you be interested in applying for a credit card?</br> How about a travel card?</br> Would you like ... ?</span>", "type": "describer"}]}, {"type": "learning_points", "contents": [{"content": "Saying No Politely", "type": "heading"}, {"content": "In many countries, you cannot just say the word \"no\". You should be more polite. To politely say no, you can use expressions like:<br><br><span class=\"italic\"> No, that's OK. Thank you.<br> No, I'm fine. Thank you.<br> Thanks for the offer, but no thank you.<br> I appreciate the offer, but ... <br>   I'll pass, thank you.  <br/> I'm not interested right now.</span>", "type": "describer"}, {"content": " <span class=\"strong\">Bank Teller</span>: Would you like to apply for a credit card?<br>  <span class=\"strong\">Customer</span>: Thanks for the offer, but no thank you.", "type": "example"}, {"content": "Notice that these expressions use the  <span class=\"strong\">Simple Present</span> tense.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to log in", "type": "name"}, {"content": "to type information into a website so you can use it", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You can log into the bank's website.", "type": "example"}, {"content": "engenn3le05ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use at the bank.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "bank account", "type": "name"}, {"content": "an agreement between you and the bank where you make deposits  and take out money", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'd like to open a bank account, please. ", "type": "example"}, {"content": "engenn3le05ob03aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "account number", "type": "name"}, {"content": "a number used to identify an account", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Type in your account number to log in.", "type": "example"}, {"content": "engenn3le05ob03aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "password", "type": "name"}, {"content": "a secret group of letters and/or numbers  you must type in before you can log in", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Do I type in my password here?", "type": "example"}, {"content": "engenn3le05ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "convenient", "type": "name"}, {"content": "useful to you because it saves time", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: A credit card is convenient for travel. ", "type": "example"}, {"content": "engenn3le05ob03aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "prepaid", "type": "name"}, {"content": "paid before it is needed or used", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example:  This is a prepaid credit card.", "type": "example"}, {"content": "engenn3le05ob03aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to run low", "type": "name"}, {"content": "to near the end of an amount of something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: When the amount starts to run low, you can add more money.", "type": "example"}, {"content": "engenn3le05ob03aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "fund", "type": "name"}, {"content": "an amount of money available ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You can add more when you run low on funds.", "type": "example"}, {"content": "engenn3le05ob03aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "currency", "type": "name"}, {"content": "the money that a country uses", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Remember to use the correct currency when traveling.", "type": "example"}, {"content": "engenn3le05ob03aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to reload", "type": "name"}, {"content": "to add more; to fill up", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You can reload your card online. ", "type": "example"}, {"content": "engenn3le05ob03aud10", "type": "audio"}]}, {"content": "engenn3le05ob03re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Read each role below and choose one.", "type": "text"}, {"content": "Practice the situation with your partner.", "type": "text"}, {"content": "Change roles. <br/> <br/><span class=\"strong\">Role&nbsp;1:</span> You are the customer. The bank teller offers you a credit card. Say<span class=\"italic\"> no</span> politely. <br/> <br/><span class=\"strong\">Role&nbsp;2:</span> You are the bank teller. You offer the customer a credit card. Use words about money and banking. They reject the offer.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I make offers using modals.", "type": "text"}, {"content": "I say <span class=\"italic\">no</span> to an offer politely.", "type": "text"}, {"content": "I talk about money and banking.", "type": "text"}, {"content": "I act out being a bank teller and a customer.", "type": "text"}]}], "type": "sena"}